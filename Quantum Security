            blocked_sgs.append(sg_id)
        except ec2.exceptions.ClientError as e:
            # Rule may not exist yet (first block) — add it instead
            if "InvalidPermission.NotFound" in str(e):
                try:
                    ec2.authorize_security_group_ingress(
                        GroupId=sg_id,
                        IpPermissions=[{
                            "IpProtocol": "-1",
                            "FromPort": -1,
                            "ToPort": -1,
                            "IpRanges": [{
                                "CidrIp": f"{attacker_ip}/32",
                                "Description": f"BLOCKED by QuantumSOC | finding={finding_id}",
                            }],
                        }],
