def block_ip_in_honeypot_sgs(attacker_ip: str, finding_id: str) -> list[str]:
    """
    Block the attacker IP in the deny-list security group attached
    to every honeypot VPC. Returns list of SG IDs updated.
    """
    blocked_sgs = []

    # Get all SGs tagged as honeypot lures across our VPCs
    response = ec2.describe_security_groups(
        Filters=[
            {"Name": "vpc-id", "Values": HONEYPOT_VPC_IDS},
            {"Name": "tag:Role", "Values": ["HoneypotLure"]},
        ]
    )

    for sg in response.get("SecurityGroups", []):
        sg_id = sg["GroupId"]
        try:
            ec2.revoke_security_group_ingress(
                GroupId=sg_id,
                IpPermissions=[{
                    "IpProtocol": "-1",
                    "IpRanges": [{
                        "CidrIp": f"{attacker_ip}/32",
                        "Description": f"BLOCKED by QuantumSOC | finding={finding_id}",
                    }],
                }],
