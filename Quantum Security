Quantum SOC — Auto-Isolation Lambda
====================================
Triggered by EventBridge when GuardDuty fires a finding.
Actions taken based on severity:

  MEDIUM (4-6):  Log + alert only
  HIGH   (7-8):  Block attacker IP in all honeypot SGs + alert
  CRITICAL (9+): Block IP + attempt EC2 isolation via SSM + alert
"""

import json
import os
import boto3
import logging
from datetime import datetime, timezone

logger = logging.getLogger()
logger.setLevel(logging.INFO)

ec2    = boto3.client("ec2")
sns    = boto3.client("sns")
ssm    = boto3.client("ssm")
logs   = boto3.client("logs")

QUARANTINE_SG_ID    = os.environ["QUARANTINE_SG_ID"]
HONEYPOT_VPC_IDS    = os.environ["HONEYPOT_VPC_IDS"].split(",")
ALERT_SNS_TOPIC_ARN = os.environ["ALERT_SNS_TOPIC_ARN"]
ENVIRONMENT         = os.environ["ENVIRONMENT"]


def lambda_handler(event, context):
    """Entry point — parse GuardDuty finding and dispatch actions."""
    logger.info("Received event: %s", json.dumps(event))

    detail   = event.get("detail", {})
    severity = float(detail.get("severity", 0))
    finding_type = detail.get("type", "Unknown")
    finding_id   = detail.get("id", "unknown")
    description  = detail.get("description", "")
    region       = event.get("region", "us-east-1")
    account_id   = detail.get("accountId", "unknown")

    # Extract attacker IP from the finding
    attacker_ip = extract_attacker_ip(detail)

    result = {
        "finding_id":   finding_id,
        "finding_type": finding_type,
        "severity":     severity,
        "attacker_ip":  attacker_ip,
        "actions_taken": [],
        "timestamp":    datetime.now(timezone.utc).isoformat(),
    }

    logger.info(
        "Processing finding | severity=%.1f | type=%s | attacker_ip=%s",
        severity, finding_type, attacker_ip
    )

    # ── MEDIUM (4–6): Log and alert only ──────────────────────
    if 4 <= severity < 7:
        result["actions_taken"].append("logged")
        send_alert(
            severity_label="MEDIUM",
            finding_type=finding_type,
            attacker_ip=attacker_ip,
            description=description,
            finding_id=finding_id,
            region=region,
            account_id=account_id,
            actions=["Logged finding — monitoring for escalation"],
        )

    # ── HIGH (7–8): Block IP across all honeypot SGs ──────────
    elif 7 <= severity < 9:
        if attacker_ip:
            blocked_sgs = block_ip_in_honeypot_sgs(attacker_ip, finding_id)
            result["actions_taken"].extend(
                [f"blocked_ip_in_sg:{sg}" for sg in blocked_sgs]
            )

        send_alert(
            severity_label="HIGH",
            finding_type=finding_type,
            attacker_ip=attacker_ip,
            description=description,
            finding_id=finding_id,
            region=region,
            account_id=account_id,
            actions=[
                f"Blocked {attacker_ip} in {len(blocked_sgs)} security groups",
                "Analyst review recommended within 1 hour",
            ] if attacker_ip else ["No attacker IP found — manual review required"],
        )

    # ── CRITICAL (9+): Full isolation ─────────────────────────
    elif severity >= 9:
        if attacker_ip:
            blocked_sgs = block_ip_in_honeypot_sgs(attacker_ip, finding_id)
            result["actions_taken"].extend(
                [f"blocked_ip_in_sg:{sg}" for sg in blocked_sgs]
            )

        # Try to isolate the specific EC2 instance involved
        instance_id = extract_instance_id(detail)
        if instance_id:
            isolated = isolate_ec2_instance(instance_id, finding_id)
            if isolated:
                result["actions_taken"].append(f"isolated_ec2:{instance_id}")

        send_alert(
            severity_label="🚨 CRITICAL",
            finding_type=finding_type,
            attacker_ip=attacker_ip,
            description=description,
            finding_id=finding_id,
            region=region,
            account_id=account_id,
            actions=[
                f"BLOCKED {attacker_ip} in all honeypot security groups" if attacker_ip else "No attacker IP",
                f"ISOLATED EC2 instance {instance_id}" if instance_id else "No instance targeted",
                "IMMEDIATE analyst response required",
            ],
        )

    logger.info("Result: %s", json.dumps(result))
    return result


def extract_attacker_ip(detail: dict) -> str | None:
    """Pull the remote IP from a GuardDuty finding detail object."""
    service = detail.get("service", {})

    # Network connection findings
    action = service.get("action", {})
    for action_type in ["networkConnectionAction", "portProbeAction"]:
        remote = (
            action.get(action_type, {})
            .get("remoteIpDetails", {})
            .get("ipAddressV4")
        )
        if remote:
            return remote

    # DNS request findings
    dns = action.get("dnsRequestAction", {})
    if dns.get("domain"):
        return None  # DNS findings don't have a direct IP to block

    return None


def extract_instance_id(detail: dict) -> str | None:
    """Pull the affected EC2 instance ID if present."""
    resource = detail.get("resource", {})
    instance = resource.get("instanceDetails", {})
    return instance.get("instanceId")


def block_ip_in_honeypot_sgs(attacker_ip: str, finding_id: str) -> list[str]:
    """
    Block the attacker IP in the deny-list security group attached
    to every honeypot VPC. Returns list of SG IDs updated.
    """
    blocked_sgs = []

    # Get all SGs tagged as honeypot lures across our VPCs
    response = ec2.describe_security_groups(
        Filters=[
            {"Name": "vpc-id", "Values": HONEYPOT_VPC_IDS},
            {"Name": "tag:Role", "Values": ["HoneypotLure"]},
        ]
    )

    for sg in response.get("SecurityGroups", []):
        sg_id = sg["GroupId"]
        try:
            ec2.revoke_security_group_ingress(
                GroupId=sg_id,
                IpPermissions=[{
                    "IpProtocol": "-1",
                    "IpRanges": [{
                        "CidrIp": f"{attacker_ip}/32",
                        "Description": f"BLOCKED by QuantumSOC | finding={finding_id}",
                    }],
                }],
            )
            logger.info("Blocked %s in SG %s", attacker_ip, sg_id)
            blocked_sgs.append(sg_id)
        except ec2.exceptions.ClientError as e:
            # Rule may not exist yet (first block) — add it instead
            if "InvalidPermission.NotFound" in str(e):
                try:
                    ec2.authorize_security_group_ingress(
                        GroupId=sg_id,
                        IpPermissions=[{
                            "IpProtocol": "-1",
                            "FromPort": -1,
                            "ToPort": -1,
                            "IpRanges": [{
                                "CidrIp": f"{attacker_ip}/32",
                                "Description": f"BLOCKED by QuantumSOC | finding={finding_id}",
                            }],
                        }],
                    )
                    blocked_sgs.append(sg_id)
                except Exception as inner:
                    logger.error("Failed to add block rule in %s: %s", sg_id, inner)
            else:
                logger.error("Error modifying SG %s: %s", sg_id, e)

    # Always add to quarantine SG too
    try:
        ec2.authorize_security_group_ingress(
            GroupId=QUARANTINE_SG_ID,
            IpPermissions=[{
                "IpProtocol": "-1",
                "FromPort": -1,
                "ToPort": -1,
                "IpRanges": [{
                    "CidrIp": f"{attacker_ip}/32",
                    "Description": f"Quarantined by QuantumSOC | finding={finding_id}",
                }],
            }],
        )
    except Exception as e:
        logger.warning("Quarantine SG update skipped: %s", e)

    return blocked_sgs


def isolate_ec2_instance(instance_id: str, finding_id: str) -> bool:
    """
    Moves the instance to the quarantine security group and
    optionally runs an SSM isolation script on the host.
    """
    try:
        ec2.modify_instance_attribute(
            InstanceId=instance_id,
            Groups=[QUARANTINE_SG_ID],
        )
        logger.info("Moved instance %s to quarantine SG", instance_id)
    except Exception as e:
        logger.error("Failed to isolate instance %s: %s", instance_id, e)
        return False

    # Run an SSM command to freeze the instance at the OS level
    try:
