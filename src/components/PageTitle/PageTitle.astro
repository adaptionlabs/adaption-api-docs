---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { AIDropdown } from "@stainless-api/docs/components/AIDropdown";
import { ContentBreadcrumbs } from "@stainless-api/docs/components/ContentBreadcrumbs";
import {
  ENABLE_CONTEXT_MENU,
  ENABLE_PROSE_MARKDOWN_RENDERING,
  RENDER_PAGE_DESCRIPTIONS,
} from "virtual:stl-docs-virtual-module";
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

function sidebarHasEntry(
  sidebarEntry: StarlightRouteData["sidebar"],
  currentPath?: string,
) {
  if (!currentPath) return false;

  const normalizePath = (path: string) =>
    path.endsWith("/") ? path : `${path}/`;
  const normalizedCurrent = normalizePath(currentPath);

  for (const entry of sidebarEntry) {
    if (entry.type === "link") {
      if (normalizePath(entry.href) === normalizedCurrent) return true;
    } else if (
      entry.type === "group" &&
      sidebarHasEntry(entry.entries, currentPath)
    ) {
      return true;
    }
  }

  return false;
}

const { entry, editUrl, sidebar } = Astro.locals.starlightRoute;
const currentPath = Astro.url.pathname;
const skipTitle =
  Astro.locals._stlStarlightPage?.skipRenderingStarlightTitle ?? false;
const hasMarkdownRoute =
  Astro.locals._stlStarlightPage?.hasMarkdownRoute ?? true;
const hasContextMenu =
  sidebarHasEntry(sidebar, currentPath) &&
  hasMarkdownRoute &&
  ENABLE_PROSE_MARKDOWN_RENDERING &&
  ENABLE_CONTEXT_MENU;
const isAuthoredDoc =
  entry.filePath.startsWith("src/content/docs/") &&
  entry.filePath.endsWith(".mdx") &&
  entry.filePath !== "src/content/docs/index.mdx";
const description = entry.data.description;
---

{
  skipTitle ? null : (
    <>
      <div
        class="stl-ui-not-prose stl-page-nav-container stl-prose-page-nav-container"
        data-pagefind-ignore
      >
        <ContentBreadcrumbs currentPath={currentPath} sidebarEntry={sidebar} />
        {hasContextMenu && (
          <div class="page-actions">
            {isAuthoredDoc && editUrl && (
              <a
                class="github-edit-link stl-ui-dropdown__button stl-ui-dropdown-button--action"
                href={editUrl}
              >
                <svg
                  aria-hidden="true"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.28-1.29-5.28-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.07.78 2.16v3.21c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
                </svg>
                <span>Edit on GitHub</span>
              </a>
            )}
            <AIDropdown />
          </div>
        )}
      </div>
      <Default />
      {!!description && RENDER_PAGE_DESCRIPTIONS && (
        <p class="description">{description}</p>
      )}
    </>
  )
}

<style>
  .page-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .github-edit-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 2rem;
    padding-inline: calc(0.75rem - 1px);
    border: 1px solid var(--stl-color-border);
    border-radius: var(--stl-ui-layout-border-radius-sml);
    background: var(--stl-color-ui-background);
    color: var(--stl-color-foreground);
    font-size: var(--stl-typography-scale-sm);
    font-weight: var(--docs-font-weight-chrome);
    line-height: 100%;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .github-edit-link:hover {
    background: var(--stl-color-ui-background-hover);
    color: var(--stl-color-foreground);
  }

  .github-edit-link:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  p.description {
    margin-top: 0.4em;
    font-size: var(--stl-typography-scale-xl);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }
</style>
